<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RIHNetLogistikMDE"
        tools:targetApi="33">

        <activity
            android:name=".ui.inventur.InventurActivity"
            android:exported="false"
            android:label="@string/title_inventur"/>

        <activity
            android:name=".ui.infokorrektur.artikelabbuchen.ArtikelAbbuchenActivity"
            android:exported="false"
            android:label="@string/title_artikelabbuchen"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.infokorrektur.artikelzubuchen.ArtikelZubuchenActivity"
            android:exported="false"
            android:label="@string/title_artikelzubuchen"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.infokorrektur.lagerplatzinfo.LagerplatzinfoActivity"
            android:exported="false"
            android:label="@string/title_lagerplatzinfo" />

        <activity
            android:name=".ui.infokorrektur.InfoKorrekturActivity"
            android:exported="false"
            android:label="@string/title_infokorrektur"/>

        <activity
            android:name=".ui.infokorrektur.artikelinfo.ArtikelinfoActivity"
            android:exported="false"
            android:label="@string/title_artikelinfo"/>

        <activity
            android:name=".ui.umlagerung.buchung.BuchungActivity"
            android:exported="false"
            android:label="@string/title_umlagern" />

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:label="@string/title_login"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.umlagerung.artikel.ChargeActivity"
            android:exported="false"
            android:label="@string/title_charge" />

        <activity
            android:name=".ui.umlagerung.artikel.SeriennummerActivity"
            android:exported="false"
            android:label="@string/title_seriennummer" />

        <activity
            android:name=".ui.umlagerung.UmlagerungActivity"
            android:exported="false"
            android:label="@string/title_umlagerung"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.splash.SplashActivity"
            android:configChanges="orientation|keyboardHidden|screenSize"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.RIHNetLogistikMDE.Fullscreen"
            tools:ignore="LockedOrientationActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/title_activity_settings"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity" />

        <activity
            android:name=".ui.main.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustNothing"
            tools:ignore="LockedOrientationActivity" />

    </application>

</manifest>