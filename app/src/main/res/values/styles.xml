<resources>

    <!-- Fullscreen ActionBar (alt/kompatibel) -->
    <style name="Widget.Theme.RIHNetLogistikMDE.ActionBar.Fullscreen"
        parent="Widget.AppCompat.ActionBar">
        <item name="android:background">@color/black</item>
    </style>

    <!-- Fullscreen ButtonBar (alt/kompatibel) -->
    <style name="Widget.Theme.RIHNetLogistikMDE.ButtonBar.Fullscreen"
        parent="Widget.AppCompat.ButtonBar">
        <item name="android:background">@color/black</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <!-- ✅ M3: Toolbar -->
    <style name="Widget.App.Toolbar" parent="Widget.Material3.Toolbar">
        <item name="android:background">?attr/colorPrimary</item>
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="materialThemeOverlay">@style/ThemeOverlay.Material3.Dark.ActionBar</item>
    </style>

    <!-- ✅ M3: Extended FAB -->
    <!-- Wichtig: NICHT mehr MaterialComponents.* (M2), sondern Material3.* -->
    <style name="Widget.App.ExtendedFloatingActionButton"
        parent="Widget.MaterialComponents.ExtendedFloatingActionButton">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.ExtendedFloatingActionButton</item>
    </style>


    <!-- ✅ M3 Shape -->
    <style name="ShapeAppearance.App.ExtendedFloatingActionButton"
        parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

</resources>
