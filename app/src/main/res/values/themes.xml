<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.RIHNetLogistikMDE" parent="Theme.Material3.Light.NoActionBar">
        <!-- parent="Theme.Material3.DayNight.NoActionBar" -->
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/red_a700</item>
        <item name="colorPrimaryVariant">@color/red_dark</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/amber_a700</item>
        <item name="colorSecondaryVariant">@color/amber_dark</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar color. -->
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>

        <!-- Customize your theme here. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.RIHNetLogistikMDE" parent="Base.Theme.RIHNetLogistikMDE" />

    <style name="Theme.RIHNetLogistikMDE.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar">
        <item name="android:textColor">?android:textColorPrimary</item>
    </style>

    <style name="Theme.RIHNetLogistikMDE.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="Theme.RIHNetLogistikMDE.Fullscreen" parent="Theme.RIHNetLogistikMDE">
        <item name="android:actionBarStyle">
            @style/Widget.Theme.RIHNetLogistikMDE.ActionBar.Fullscreen
        </item>
        <item name="android:windowActionBarOverlay">true</item>
        <item name="android:windowBackground">@null</item>
    </style>

    <style name="ThemeOverlay.RIHNetLogistikMDE.FullscreenContainer" parent="">
        <item name="fullscreenBackgroundColor">@color/light_blue_600</item>
        <item name="fullscreenTextColor">@color/light_blue_A200</item>
    </style>

    <style name="Theme.RIHNetLogistikMDE.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>