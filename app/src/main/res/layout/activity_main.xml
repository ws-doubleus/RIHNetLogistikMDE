<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Material3.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="@string/app_name" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp">

            <!-- Helper: wiederverwendbare Card-Optik pro Card setzen -->
            <!-- Infokorrektur -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_infokorrektur"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/main_card_container"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/icon_infokorrektur"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_edit_note"
                        app:tint="@color/main_card_content" />

                    <TextView
                        android:id="@+id/text_infokorrektur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title_infokorrektur"
                        android:duplicateParentState="true"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/main_card_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Warenausgang -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_warenausgang"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/main_card_container"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/icon_warenausgang"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_output"
                        app:tint="@color/main_card_content" />

                    <TextView
                        android:id="@+id/text_warenausgang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title_warenausgang"
                        android:duplicateParentState="true"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/main_card_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Wareneingang -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_wareneingang"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/main_card_container"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/icon_wareneingang"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_exit_to_app"
                        app:tint="@color/main_card_content" />

                    <TextView
                        android:id="@+id/text_wareneingang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title_wareneingang"
                        android:duplicateParentState="true"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/main_card_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Umlagerung -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_umlagerung"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/main_card_container"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/icon_umlagerung"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_u_turn_right"
                        app:tint="@color/main_card_content" />

                    <TextView
                        android:id="@+id/text_umlagerung"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title_umlagerung"
                        android:duplicateParentState="true"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/main_card_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Inventur -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_inventur"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/main_card_container"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/icon_inventur"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_task_alt"
                        app:tint="@color/main_card_content" />

                    <TextView
                        android:id="@+id/text_inventur"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title_inventur"
                        android:duplicateParentState="true"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/main_card_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Paketlabel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_paketlabel"
                style="?attr/materialCardViewElevatedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="@color/main_card_container"
                app:strokeColor="@color/main_card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <ImageView
                        android:id="@+id/icon_paketlabel"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:duplicateParentState="true"
                        android:src="@drawable/ic_document_scanner"
                        app:tint="@color/main_card_content" />

                    <TextView
                        android:id="@+id/text_paketlabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/title_paketlabel"
                        android:duplicateParentState="true"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        android:textColor="@color/main_card_content" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
