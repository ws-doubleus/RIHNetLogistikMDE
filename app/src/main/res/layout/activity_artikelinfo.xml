<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.infokorrektur.artikelinfo.ArtikelinfoActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="2dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.App.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize" />

    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:id="@+id/sv_data"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/grey_50"
        android:visibility="gone"
        android:layout_marginTop="?attr/actionBarSize">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:orientation="vertical"
            android:paddingVertical="12dp">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="4dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/tv_artikelnummer_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artikel_artikelnummer"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_artikelnummer"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tv_artikelnummer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_artikelnummer_label"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:text="0015.85.5.0" />

                    <TextView
                        android:id="@+id/tv_bezeichnung_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artikel_bezeichnung"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_bezeichnung"
                        app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

                    <TextView
                        android:id="@+id/tv_bezeichnung"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                        app:layout_constraintTop_toBottomOf="@+id/tv_artikelnummer"
                        tools:text="Musterartikel" />

                    <TextView
                        android:id="@+id/tv_zusatz_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artikel_zusatz"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_zusatz"
                        app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

                    <TextView
                        android:id="@+id/tv_zusatz"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                        app:layout_constraintTop_toBottomOf="@+id/tv_bezeichnung"
                        tools:text="Zusatz mit sehr langem Text und...." />

                    <TextView
                        android:id="@+id/tv_hstartikelnummer_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artikel_hstartikelnummer"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_hstartikelnummer"
                        app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

                    <TextView
                        android:id="@+id/tv_hstartikelnummer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                        app:layout_constraintTop_toBottomOf="@+id/tv_zusatz"
                        tools:text="365555azu" />

                    <TextView
                        android:id="@+id/tv_eannummer_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/artikel_eannummer"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBaseline_toBaselineOf="@+id/tv_eannummer"
                        app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

                    <TextView
                        android:id="@+id/tv_eannummer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        android:textColor="?attr/colorPrimary"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                        app:layout_constraintTop_toBottomOf="@+id/tv_hstartikelnummer"
                        tools:text="908785422257" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_lager"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:layout_marginVertical="6dp" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </ScrollView>

    <TextView
        android:id="@+id/tv_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/text_artikel_suchen"
        android:gravity="center"
        android:layout_marginTop="?attr/actionBarSize"
        android:layout_gravity="center"
        android:visibility="visible"
        android:textAppearance="@style/TextAppearance.AppCompat.Small" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>