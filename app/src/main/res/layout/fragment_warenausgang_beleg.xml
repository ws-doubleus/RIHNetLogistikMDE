                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/tv_lieferadresse_strasse"
                            app:layout_constraintTop_toTopOf="parent"
                            tools:text="Sabine Wagner" />

                        <TextView
                            android:id="@+id/tv_lieferadresse_strasse_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/beleg_strasse"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_lieferadresse_strasse"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/tv_lieferadresse_strasse"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            android:textColor="?attr/colorPrimary"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/tv_lieferadresse_strasse_label"
                            app:layout_constraintTop_toBottomOf="@+id/tv_lieferadresse_name"
                            tools:text="Radweg 4" />

                        <TextView
                            android:id="@+id/tv_lieferadresse_plz_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/beleg_plz"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"
                            app:layout_constraintBaseline_toBaselineOf="@+id/tv_lieferadresse_plz"
                            app:layout_constraintEnd_toEndOf="@+id/tv_lieferadresse_strasse_label" />

                        <TextView
                            android:id="@+id/tv_lieferadresse_plz"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
