                            app:layout_constraintEnd_toEndOf="@+id/tv_lieferadresse_strasse_label" />

                        <TextView
                            android:id="@+id/tv_lieferadresse_land"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
