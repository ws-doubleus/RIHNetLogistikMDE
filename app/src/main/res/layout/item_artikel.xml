<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cv_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="3dp"
    android:foreground="?android:attr/selectableItemBackground"
    app:cardCornerRadius="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <TextView
            android:id="@+id/tv_belegnummer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artikel_belegnummer"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_belegnummer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_belegnummer_label"
            app:layout_constraintStart_toEndOf="@+id/tv_artikelnummer_label"
            tools:text="2024001" />

        <TextView
            android:id="@+id/tv_pipe"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="@string/queue_pipe"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toEndOf="@+id/tv_belegnummer"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_belegnummer" />

        <TextView
            android:id="@+id/tv_position"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_belegnummer"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/tv_pipe"
            tools:text="1.1" />

        <TextView
            android:id="@+id/tv_artikelnummer_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artikel_artikelnummer"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_belegnummer" />

        <TextView
            android:id="@+id/tv_artikelnummer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_artikelnummer_label"
            app:layout_constraintStart_toEndOf="@+id/tv_artikelnummer_label"
            tools:text="125478999687" />

        <TextView
            android:id="@+id/tv_bezeichnung_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artikel_bezeichnung"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_artikelnummer" />

        <TextView
            android:id="@+id/tv_bezeichnung"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_bezeichnung_label"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
            tools:text="Musterartikel mit langer Bezeichnung" />

        <TextView
            android:id="@+id/tv_menge_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/artikel_menge_offen"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label"
            app:layout_constraintTop_toBottomOf="@+id/tv_bezeichnung" />

        <TextView
            android:id="@+id/tv_menge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_menge_label"
            app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
            tools:text="1" />

        <TextView
            android:id="@+id/tv_pipe1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:text="@string/queue_pipe"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintStart_toEndOf="@+id/tv_menge"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_menge_label" />

        <TextView
            android:id="@+id/tv_offen"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="12dp"
            android:textAppearance="@style/TextAppearance.AppCompat.Small"
            android:textColor="@color/red_500"
            app:layout_constraintBaseline_toBaselineOf="@+id/tv_menge_label"
            app:layout_constraintStart_toEndOf="@+id/tv_pipe1"
            tools:text="1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.cardview.widget.CardView>