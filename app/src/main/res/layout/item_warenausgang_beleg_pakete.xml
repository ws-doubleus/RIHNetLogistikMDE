<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginVertical="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tv_nummer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceSubtitle1"
        android:text="@string/pakete_nummer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_gewicht_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/artikel_gewicht"
        android:contentDescription=""
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_nummer"/>

    <TextView
        android:id="@+id/tv_gewicht"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="?attr/colorPrimary"
        android:contentDescription=""
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_gewicht_label"
        app:layout_constraintStart_toEndOf="@+id/tv_gewicht_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1,70" />

    <TextView
        android:id="@+id/tv_wert_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/artikel_wert"
        android:contentDescription=""
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        app:layout_constraintEnd_toEndOf="@+id/tv_gewicht_label"
        app:layout_constraintTop_toBottomOf="@+id/tv_gewicht"/>

    <TextView
        android:id="@+id/tv_wert"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.AppCompat.Small"
        android:textColor="?attr/colorPrimary"
        android:contentDescription=""
        app:layout_constraintBaseline_toBaselineOf="@+id/tv_wert_label"
        app:layout_constraintStart_toEndOf="@+id/tv_wert_label"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="1.200,50" />


</androidx.constraintlayout.widget.ConstraintLayout>
