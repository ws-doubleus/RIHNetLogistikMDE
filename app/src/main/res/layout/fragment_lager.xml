<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.umlagerung.lager.LagerFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@color/gray_200">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="12dp"
            android:background="@color/gray_200">

            <androidx.cardview.widget.CardView
                android:id="@+id/cv_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                app:cardCornerRadius="4dp"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingVertical="8dp"
                    android:paddingStart="12dp">

                    <TextView
                        android:id="@+id/tv_lager_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/acs_lager"
                        android:text="@string/lager_quellager"
                        android:textAlignment="textStart"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBottom_toBottomOf="@+id/acs_lager"
                        app:layout_constraintEnd_toEndOf="@+id/tv_lagerplatz_label"
                        app:layout_constraintTop_toTopOf="@+id/acs_lager" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/acs_lager"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_lager_label"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_max="480dp" />

                    <TextView
                        android:id="@+id/tv_lagerplatz_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:labelFor="@+id/acs_lager"
                        android:text="@string/lager_lagerplatz"
                        android:textAlignment="textStart"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintBottom_toBottomOf="@+id/acs_lagerplatz"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/acs_lagerplatz" />

                    <androidx.appcompat.widget.AppCompatSpinner
                        android:id="@+id/acs_lagerplatz"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="4dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/tv_lager_label"
                        app:layout_constraintTop_toBottomOf="@+id/acs_lager"
                        app:layout_constraintWidth_max="480dp" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_menge_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/artikel_menge"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_menge"
                app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

            <TextView
                android:id="@+id/tv_menge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorAccent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                app:layout_constraintTop_toBottomOf="@+id/cv_info"
                tools:text="1" />

            <View
                android:id="@+id/v_separator"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_margin="12dp"
                android:background="@android:color/darker_gray"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_menge" />

            <TextView
                android:id="@+id/tv_artikelnummer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/artikel_artikelnummer"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_artikelnummer"
                app:layout_constraintStart_toStartOf="parent" />

            <TextView
                android:id="@+id/tv_artikelnummer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorAccent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tv_artikelnummer_label"
                app:layout_constraintTop_toBottomOf="@+id/v_separator"
                tools:text="125478999687" />

            <TextView
                android:id="@+id/tv_bezeichnung_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/artikel_bezeichnung"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label"
                app:layout_constraintTop_toBottomOf="@+id/tv_artikelnummer" />

            <TextView
                android:id="@+id/tv_bezeichnung"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorAccent"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_bezeichnung_label"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                tools:text="Musterartikel mit langer Bezeichnung" />

            <TextView
                android:id="@+id/tv_zusatz_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/artikel_zusatz"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_zusatz"
                app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

            <TextView
                android:id="@+id/tv_zusatz"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorAccent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                app:layout_constraintTop_toBottomOf="@+id/tv_bezeichnung"
                tools:text="Zusatz mit sehr langem Text und...." />

            <TextView
                android:id="@+id/tv_hstartikelnummer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/artikel_hstartikelnummer"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_hstartikelnummer"
                app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

            <TextView
                android:id="@+id/tv_hstartikelnummer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorAccent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                app:layout_constraintTop_toBottomOf="@+id/tv_zusatz"
                tools:text="365555azu" />

            <TextView
                android:id="@+id/tv_seriennummercharge_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/artikel_seriennummer"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                app:layout_constraintBaseline_toBaselineOf="@+id/tv_seriennummercharge"
                app:layout_constraintEnd_toEndOf="@+id/tv_artikelnummer_label" />

            <TextView
                android:id="@+id/tv_seriennummercharge"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="12dp"
                android:textAppearance="@style/TextAppearance.AppCompat.Small"
                android:textColor="?attr/colorAccent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="@+id/tv_artikelnummer"
                app:layout_constraintTop_toBottomOf="@+id/tv_hstartikelnummer"
                tools:text="18747490405r8308" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <Button
        android:id="@+id/btn_queue"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="6dp"
        android:text="@string/btn_queue"
        app:icon="@drawable/ic_playlist_add" />

</androidx.appcompat.widget.LinearLayoutCompat>